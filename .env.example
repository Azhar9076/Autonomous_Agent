# Copy this file to .env and fill in your key.
# You only need ONE of the four LLM providers below.

# --- Option 1: Groq — default, used by the code unless you change LLM_PROVIDER ---
# Groq is the fast-inference company (console.groq.com), keys start with gsk_.
# NOT the same as Grok/xAI below — easy to mix up, different companies.
GROQ_API_KEY=your-groq-api-key-here
LLM_PROVIDER=groq
LLM_MODEL=openai/gpt-oss-120b
# Get a key at https://console.groq.com

# --- Option 2: Grok (xAI) ---
# XAI_API_KEY=your-xai-api-key-here
# LLM_PROVIDER=grok
# LLM_MODEL=grok-4.6
# Get a key at https://console.x.ai (keys start with xai-)

# --- Option 3: Anthropic (Claude) ---
# ANTHROPIC_API_KEY=your-anthropic-api-key-here
# LLM_PROVIDER=anthropic
# LLM_MODEL=claude-sonnet-4-6

# --- Option 4: OpenAI ---
# OPENAI_API_KEY=your-openai-api-key-here
# LLM_PROVIDER=openai
# LLM_MODEL=gpt-4o-mini

# Max number of Editor -> Writer revision cycles before the system
# force-stops and outputs the best draft so far.
MAX_REVISIONS=3

# Flask web UI settings
FLASK_SECRET_KEY=change-me-to-something-random
FLASK_PORT=5000
